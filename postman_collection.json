{
  "info": {
    "name": "Fuel Route Optimizer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Route between two US locations with cost-optimal fuel stops (500 mi range, 10 MPG)."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ],
          "query": []
        },
        "description": ""
      }
    },
    {
      "name": "City autocomplete: \"chi\"",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/places/?q=chi&limit=8",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "places",
            ""
          ],
          "query": [
            {
              "key": "q",
              "value": "chi"
            },
            {
              "key": "limit",
              "value": "8"
            }
          ]
        }
      }
    },
    {
      "name": "City autocomplete with state filter: \"spring, mo\"",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/places/?q=spring, mo",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "places",
            ""
          ],
          "query": [
            {
              "key": "q",
              "value": "spring, mo"
            }
          ]
        }
      }
    },
    {
      "name": "Plan: Chicago, IL -> Denver, CO",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": ""
      }
    },
